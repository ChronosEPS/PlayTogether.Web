@model IEnumerable<PlayTogether.Web.Models.AppUser>

@{
    ViewData["Title"] = "Leaderboard";
    var rank = 1;
}

<h2>Leaderboard</h2>

<table class="table table-hover mt-3">
    <thead>
    <tr>
        <th>#</th>
        <th>Player</th>
        <th>Rating</th>
        <th>W</th>
        <th>L</th>
        <th>MVP</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@rank</td>
            <td>@p.DisplayName</td>
            <td>@p.Rating</td>
            <td>@p.Wins</td>
            <td>@p.Losses</td>
            <td>@p.MVPCount</td>
        </tr>
        rank++;
    }
    </tbody>
</table>