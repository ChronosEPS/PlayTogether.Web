@model PlayTogether.Web.Models.AppUser

@{
    ViewData["Title"] = "My Profile";
}

<h2>My Profile</h2>

<div class="card mt-3">
    <div class="card-body">
        <h4>@Model.DisplayName</h4>
        <p><b>Email:</b> @Model.Email</p>
        <p><b>Rating:</b> @Model.Rating</p>
        <p><b>Games Played:</b> @Model.GamesPlayed</p>
        <p><b>Wins:</b> @Model.Wins</p>
        <p><b>Losses:</b> @Model.Losses</p>
        <p><b>MVP:</b> @Model.MVPCount</p>
        <p><b>Joined:</b> @Model.JoinedAt.ToString("yyyy-MM-dd")</p>
    </div>
</div>