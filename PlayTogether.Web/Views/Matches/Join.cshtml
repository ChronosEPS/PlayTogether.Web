@model PlayTogether.Web.Models.ViewModels.JoinMatchViewModel

@{
    ViewData["Title"] = "Join Match";
}

<h2>Join: @Model.MatchTitle</h2>
<p class="text-muted">Sport: <b>@Model.SportType</b></p>
<p class="text-muted">Choose <b>2 or 3 roles</b> required for this sport.</p>

<form asp-action="Join" method="post">
    <input type="hidden" asp-for="MatchId" />

    <div asp-validation-summary="All" class="text-danger mb-2"></div>

    <div class="mb-3">
        @foreach (var role in Model.AvailableRoles)
        {
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="SelectedRoles"
                       value="@role"
                       id="role_@role.Replace(" ", "_")"
                @(Model.SelectedRoles.Contains(role) ? "checked" : "") />
                <label class="form-check-label" for="role_@role.Replace(" ", "_")">@role</label>
            </div>
        }
    </div>

    <button class="btn btn-primary" type="submit">Join Match</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>